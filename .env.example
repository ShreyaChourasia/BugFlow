# Copy to .env and fill in. Never commit the real .env (see C6).

# --- Postgres ---
POSTGRES_USER=bugflow
POSTGRES_PASSWORD=bugflow
POSTGRES_DB=bugflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bugflow:bugflow@postgres:5432/bugflow

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Auth ---
JWT_SECRET_KEY=change-me-in-real-env
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- GitHub App (Phase 4+) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# --- API ---
API_ENV=development
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
